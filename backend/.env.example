# Copy this file to .env and fill in real values.
# NEVER commit your real .env file (it's already in .gitignore).

# MongoDB connection string.
# Local dev:        mongodb://127.0.0.1:27017/pmvhouse
# Production (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pmvhouse
MONGO_URI=mongodb://127.0.0.1:27017/pmvhouse

# Port the server listens on (most hosts set this automatically - leave as is)
PORT=5000

# Admin login for the /admin panel — CHANGE THESE before going live
ADMIN_USER=admin
ADMIN_PASS=1993@123

# Secret used to sign JWT login tokens — CHANGE THIS to a long random string before going live
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=change-this-to-a-long-random-string

# Cloudinary — used to store uploaded house/property photos permanently.
# Sign up free at https://cloudinary.com/users/register/free (25GB free) then
# copy these 3 values from your Cloudinary Dashboard home page.
# Required for image uploads to work correctly in production (Render's disk
# is temporary and would otherwise lose every uploaded photo on restart).
CLOUDINARY_CLOUD_NAME=dvlohxukw
CLOUDINARY_API_KEY=277918189628732
CLOUDINARY_API_SECRET=3x2gBLKLiUl91HH2gUPvCU3Jcgw

# Your live frontend URL(s), comma-separated if more than one. Restricts which
# websites are allowed to call this API. Leave blank/unset during setup to
# allow all origins ("*"), then lock it down once your frontend URL is final.
# Example: FRONTEND_URL=https://pmvproperties.vercel.app,https://pmvproperties.com
FRONTEND_URL=
