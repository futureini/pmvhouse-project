# Copy this file to .env (local dev) and set the real value.
# For production builds, set VITE_API_URL in your hosting provider's
# "Environment Variables" settings (Vercel/Netlify/etc) instead of a file.

# Local development:
VITE_API_URL=http://localhost:5000

# Production example (replace with YOUR real Render backend URL):
# VITE_API_URL=https://pmvhouse-backend.onrender.com
